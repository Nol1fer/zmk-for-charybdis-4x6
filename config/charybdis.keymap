#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define _ &kp
#define _n &none
#define _t &trans

#define DEF 0
#define GAM 1
#define GFN 2
#define SYM 3
#define NAV 4
#define NUM 5
#define ALT 6
#define CMD 7

#define MEH(key) LS(LC(LA(key)))

#define SQT GRAVE
#define DQT LS(GRAVE)
#define GRV RA(GRAVE)
#define PIP LS(BSLH)
#define BSL RA(BSLH)
#define NBSP RA(SPACE)

#define NSPC LC(LG(RIGHT))
#define PSPC LC(LG(LEFT))

&sk {
	quick-release; // Avoids "THis" problem (double capitalization)
    release-after-ms = <60000>;
};

&mmv {
    time-to-max-speed-ms = <1000>;
};

&msc {
    time-to-max-speed-ms = <600>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 4>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };

        lc: mo_layer_switch_with_an_embeded_cancel_tap_for_clearing_any_queued_sticky_mods_on_press {
            compatible = "zmk,behavior-macro-one-param";
            label = "mo_layer/cancel";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings =
            <&macro_tap>,
            <&kp K_CANCEL &macro_param_1to1>,
            <&macro_press>,
            <&mo MACRO_PLACEHOLDER>,
            <&macro_pause_for_release>,
            <&macro_param_1to1>,
            <&macro_release>,
            <&mo MACRO_PLACEHOLDER>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers  = <NAV SYM>;
            then-layer = <NUM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        def_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |       |
// |       |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |       |
// |       |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   |       |
//               |     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
_n _n   _n     _n     _n      _n                                _n     _n        _n       _n     _n     &tog GAM
_n _ Q  _ W    _ E    _ R     _ T                               _ Y    _ U       _ I      _ O    _ P    _n
_n _ A  _ S    _ D    _ F     _ G                               _ H    _ J       _ K      _ L    _ SEMI _n
_n _ Z  _ X    _ C    _ V     _ B                               _ N    _ M       _ COMMA  _ DOT  _ FSLH _n
               _ SPACE &lc NAV _ CAPS                           _ LSFT &lc SYM    
                      _n      _n                                &mo ALT         
            >;

        };

        gam_layer {
            bindings = <
_n _n           _n           _n           _n          _n              _n           _n           _n           _n          _n      _n            
_n _ TAB        _ Q          _ W          _ E         _ R             _n           _n           &mmv MOVE_UP         _n          _ TAB   _n
_n _ LSFT       _ A          _ S          _ D         _ F             _n           &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT _ RSFT  _n
_n _ LCTRL      _ Z          _ X          _ C         _ V             _n           _n           _n           _n          _ RCTRL _n 
                            _ LALT       _ SPACE     &mo GFN         &tog GAM     _ SPACE          
                                         _n          _n              _ PSCRN
            >;
        };

        gfn_layer {
            bindings = <
_n _n           _n           _n           _n          _n              _n           _n           _n           _n          _n              _n
_n _ N5         _ N1         _ N2         _ N3        _ N4            &out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR_ALL _n
_n _ N0         _ N6         _ N7         _ N8        _ N9            _n           _n          _n          _n           _n               _n
_n _ G          _ J          _ I          _ M         _ T             _ KP_NUM     _n          _n          _n           _n               _n
                             _ ESC        _ RET       _t              _t           _t          
                                          _n          _n              _t  
            >;
        };

        sym_layer {
            bindings = <
_n _n           _n           _n           _n          _n              _n           _n           _n           _n           _n         _n
_n _ N1         _ N2         _ N3         _ N4        _ N5            _ N6         _ N7         _ N8         _ N9         _ N0       _n
_n _ SEMI       _ GRV        _ SQT        _ DQT       _ MINUS         _ PLUS       &sk LSHFT    &sk LCTRL    &sk LALT     &sk LGUI   _n
_n _ BSL        _n           _ LS(LBKT)   _ LBKT      _ UNDER         _ EQUAL      _ RBKT       _ LS(RBKT)   _ PIP        _ BSLH     _n
                             _t           _t          _t              _t           _t           
                                          _n          _n              _t
            >;
        };

        nav_layer {
            bindings = <
_n _n           _n           _n           _n          _n                      _n           _n           _n           _n           _n         _n
_n _ CAPS       &mkp RCLK    &mkp MCLK    &mkp LCLK   &msc SCRL_UP            _ ESC        _ HOME       _ UP         _ END        _ PG_UP    _n           
_n &sk LGUI     &sk LALT     &sk LCTRL    &sk LSHFT   &msc SCRL_DOWN          _ RET        _ LEFT       _ DOWN       _ RIGHT      _ PG_DN    _n
_n _ LC(Z)       _ LC(X)     _ LC(C)      _ LC(V)     _ ESC                   _ TAB        _ BSPC       _ DEL        _ APOS       _ KP_NUM   _n        
                             &mo CMD      _t          _t                      _t           _t
                                           _n         _n                      _t
            >;
        };

        num_layer {
            bindings = <
_n _n           _n           _n           _n          _n              _n           _n           _n           _n           _n         _n
_n _ KP_N1      _ KP_N2      _ KP_N3      _ KP_N4     _ KP_N5         _ KP_N6      _ KP_N7      _ KP_N8      _ KP_N9      _ KP_N0    _n
_n &sk LGUI     &sk LALT     &sk LCTRL    &sk LSHFT   _ F11           _ F12        &sk LSHFT    &sk LCTRL    &sk LALT     &sk LGUI   _n
_n _ F1         _ F2         _ F3         _ F4        _ F5            _ F10        _ F9         _ F8         _ F7         _ F6       _n
                             _t           _t          _t              _t           _t           
                                          _n          _n              _t
            >;
        };

        alt_layer {
            bindings = <
_n _n           _n           _n           _n          _n              _n           _n           _n           _n           _n         _n
_n _ RA(Q)      _ RA(W)      _ RA(E)      _ RA(R)     _ RA(T)         _ RA(Y)      _ RA(U)      _ RA(I)      _ RA(O)      _ RA(P)    _n
_n _ RA(A)      _ RA(S)      _ RA(D)      _ RA(F)     _ RA(G)         _ RA(H)      _ RA(J)      _ RA(K)      _ RA(L)      _ RA(SEMI) _n
_n _ RA(Z)      _ RA(X)      _ RA(C)      _ RA(V)     _ RA(B)         _ RA(N)      _ RA(M)      _ RA(COMMA)  _ RA(DOT)    _ RA(FSLH) _n
                             _t           _ NBSP      _ LSHFT         _t           _t           
                                          _n          _n              _t
            >;
        };

        cmd_layer {
            bindings = <
_n _n           _n           _n           _n          _n              _n           _n           _n           _n           _n          _n
_n _ MEH(Q)     _ MEH(W)     _ MEH(E)     _ MEH(R)    _ MEH(T)        _ MEH(Y)     _ C_VOL_DN   _ C_MUTE     _ C_VOL_UP   _ MEH(P)    _n
_n _ MEH(A)     _ MEH(S)     _ MEH(D)     _ MEH(F)    _ MEH(G)        _ MEH(H)     _ C_PREV     _ C_PP       _ C_NEXT     _ MEH(SEMI) _n
_n _n           _ MEH(X)     _ MEH(C)     _ MEH(V)    _ MEH(B)        _ MEH(N)     _ MEH(M)     _ MEH(COMMA) _ MEH(DOT)   _n          _n
                             _t           _t          _t              _ LGUI       _t           
                                          _n          _n              _t
            >;
        };

    };
    
};
